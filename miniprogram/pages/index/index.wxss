/* pages/index/index.wxss */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.context-tag {
  font-size: 26rpx;
  background: #E0F2FE;
  color: #0284C7;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: bold;
}
.btn-parent {
  font-size: 24rpx;
  background: #FFFFFF;
  border: 1px solid #CBD5E1;
  color: #334155;
  border-radius: 14rpx;
  margin: 0;
}

.sentence-strip-wrap {
  background: #FFFFFF;
  border: 4rpx solid #BAE6FD;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.strip-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.strip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0369A1;
}
.strip-count {
  font-size: 24rpx;
  color: #94A3B8;
}

.sentence-board {
  white-space: nowrap;
  min-height: 180rpx;
  background: #F0F9FF;
  border: 2rpx dashed #7DD3FC;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.strip-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}
.btn-ghost {
  font-size: 26rpx;
  background: #F1F5F9;
  color: #475569;
  border-radius: 14rpx;
  margin: 0;
}
.btn-speak {
  font-size: 30rpx;
  font-weight: bold;
  background: #0284C7;
  color: #FFFFFF;
  border-radius: 16rpx;
  margin: 0;
  padding: 0 32rpx;
}
.btn-speak.speaking {
  background: #10B981;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #475569;
  margin: 16rpx 0 10rpx;
}

.recommend-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.cat-btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 16rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
}
.cat-btn.active {
  background: #0284C7;
  color: #FFFFFF;
  border-color: #0284C7;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.card-item {
  background: #FFFFFF;
  border: 3rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  vertical-align: top;
  box-sizing: border-box;
}
.card-item.in-strip {
  width: 150rpx;
  height: 150rpx;
}
.card-item.small {
  width: 140rpx;
  padding: 10rpx;
}
.card-pinyin {
  font-size: 20rpx;
  color: #64748B;
}
.card-icon {
  font-size: 48rpx;
  margin: 6rpx 0;
}
.card-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #0F172A;
}
