<!-- pages/stats/stats.wxml -->
<view class="container">
  <view class="stat-card">
    <text class="stat-number">{{logs.length}}</text>
    <text class="stat-label">累计沟通次数</text>
  </view>

  <view class="section-title">最近沟通记录流水：</view>
  <view class="logs-list">
    <block wx:for="{{logs}}" wx:key="index">
      <view class="log-item">
        <text class="log-time">{{item.time}}</text>
        <text class="log-text">{{item.sentence}}</text>
      </view>
    </block>
    <view wx:if="{{logs.length === 0}}" class="empty-tip">暂无沟通记录</view>
  </view>
</view>
