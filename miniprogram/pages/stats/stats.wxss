/* pages/stats/stats.wxss */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 12rpx;
  text-align: center;
  border: 2rpx solid #E2E8F0;
}
.stat-number {
  font-size: 44rpx;
  font-weight: 900;
  color: #0284C7;
  display: block;
}
.stat-label {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  display: block;
}

.panel-box {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 24rpx;
  border: 2rpx solid #E2E8F0;
  margin-bottom: 24rpx;
}
.panel-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F172A;
  display: block;
  margin-bottom: 18rpx;
}
.bar-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.bar-name {
  width: 110rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
}
.bar-track {
  flex: 1;
  height: 20rpx;
  background: #F1F5F9;
  border-radius: 10rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #38BDF8, #0284C7);
  border-radius: 10rpx;
}
.bar-count {
  width: 70rpx;
  font-size: 22rpx;
  color: #0284C7;
  font-weight: 700;
  text-align: right;
}

.copy-report-btn {
  width: 100%;
  margin-bottom: 28rpx;
  padding: 14rpx 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #334155;
  margin-bottom: 14rpx;
}
.logs-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #E2E8F0;
  overflow: hidden;
}
.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.log-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F172A;
  display: block;
}
.log-time {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
  margin-top: 4rpx;
}
.log-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}
.log-badge.indep {
  background: #DCFCE7;
  color: #15803D;
}
.log-badge.prompt {
  background: #FEF3C7;
  color: #B45309;
}
.empty-tip {
  padding: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94A3B8;
}
