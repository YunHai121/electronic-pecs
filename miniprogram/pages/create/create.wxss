/* pages/create/create.wxss */
.photo-box {
  width: 240rpx;
  height: 240rpx;
  border: 3rpx dashed #94A3B8;
  border-radius: 28rpx;
  margin: 16rpx auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #FFFFFF;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #E2E8F0;
}
.form-item {
  margin-bottom: 24rpx;
}
.label {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  display: block;
  margin-bottom: 10rpx;
}
.input, .picker-box {
  background: #F8FAFC;
  border: 2rpx solid #CBD5E1;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  color: #0F172A;
}
.recorder-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.btn-rec {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  background: #F1F5F9;
  color: #334155;
  border-radius: 14rpx;
  margin: 0;
}
.btn-rec.recording {
  background: #FEE2E2;
  color: #DC2626;
}
.btn-play-rec {
  font-size: 26rpx;
  font-weight: 700;
  background: #E0F2FE;
  color: #0284C7;
  border-radius: 14rpx;
  margin: 0;
}
.btn-rec::after, .btn-play-rec::after { border: none; }
.rec-ok {
  font-size: 22rpx;
  color: #16A34A;
  font-weight: 700;
  display: block;
  margin-top: 8rpx;
}
.save-btn {
  margin-top: 32rpx;
  width: 100%;
  padding: 16rpx 0;
}
