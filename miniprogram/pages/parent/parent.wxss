/* pages/parent/parent.wxss */
.summary-banner {
  background: linear-gradient(135deg, #0EA5E9, #0284C7);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(2, 132, 199, 0.25);
}
.sum-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sum-val {
  font-size: 48rpx;
  font-weight: 900;
  color: #FFFFFF;
}
.sum-lbl {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 6rpx;
}
.sum-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.menu-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 28rpx;
}
.menu-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 28rpx 26rpx;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.menu-icon {
  font-size: 46rpx;
}
.menu-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
  display: block;
}
.menu-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  display: block;
}
.menu-arrow {
  font-size: 40rpx;
  color: #94A3B8;
  font-weight: bold;
}

.notice-card {
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  border-radius: 18rpx;
  padding: 24rpx;
}
.notice-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #92400E;
  display: block;
  margin-bottom: 8rpx;
}
.notice-text {
  font-size: 24rpx;
  color: #B45309;
  line-height: 1.55;
}
